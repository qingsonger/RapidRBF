      "downstream_issue": "https://github.com/qingsonger/RapidRBF/issues/24",
      "id": "migration.portable-artifact",
      "oracle_applicability": "not_applicable",
      "reason": "Polatory has no portable artifact. This oracle freezes legacy-to-logical-field evidence only."
    },
    {
      "classification": "intentional_compatibility_change",
      "description": "RapidRBF must provide deterministic checked handling for undefined, invalid, malformed, non-finite, or unsafe inputs.",
      "id": "change.invalid-unsafe-inputs",
      "oracle_applicability": "must_not_compare",
      "reason": "Polatory crashes, unbounded allocation, undefined behavior, and incidental NaN or Inf are diagnostic evidence only and are never candidate truth. Research scenarios relate to this item without covering it."
    },
    {
      "classification": "intentional_extension",
      "description": "Build identity, explicit seeds, configured and effective thread counts, and relevant runtime configuration.",
      "id": "extension.reproducibility-controls",
      "oracle_applicability": "required",
      "scenario_ids": [
        "build-identity",
        "scale-input-ladder"
      ]
    },
    {
      "classification": "migration_only_input",
      "description": "Frozen valid native Model and Interpolant artifacts for the observed Windows x86_64 layout.",
      "id": "legacy.model-interpolant",
      "oracle_applicability": "required",
      "scenario_ids": [
        "legacy-matrix"
      ]
    },
    {
      "classification": "internal_implementation_detail",
      "description": "Dependency identities, solver trajectories, coefficient vectors, partitions, caches, reductions, sampling, optimizer paths, and thread scheduling.",
      "id": "internal.backend-identities",
      "oracle_applicability": "must_not_compare",
      "reason": "Recorded for provenance and diagnostics only; the accepted manifest promises no compatibility for these implementation details."
    },
    {
      "classification": "explicit_exclusion",
      "description": "C++ source or ABI, cross-platform bitwise identity, exact coefficients or iteration histories, polatory-named replacement artifacts, legacy writes, VariogramSet import, exact text or padding, exact mesh numbering, and exact tessellation.",
      "id": "exclusion.noncontractual-observations",
      "oracle_applicability": "must_not_compare",
      "reason": "Raw bytes remain evidence, but downstream acceptance must compare only the semantic fields selected by later contracts."
    }
  ],
  "compatibility_manifest_issue": "https://github.com/qingsonger/RapidRBF/issues/5",
  "id": "polatory-4a30beb-windows-x86_64-behavior-oracle",
  "interpretation": {
    "accepted_surface": "May cover required manifest items through its declared selector or accepted inventory; the role does not promote every captured byte to compatibility truth.",
    "numeric_tolerance_applied": false,
    "provenance_only": "Preserves build or test context and can never satisfy required compatibility coverage.",
    "research_only": "Preserves suspected defects or unsafe legacy observations and can never satisfy required compatibility coverage.",
    "role_enforcement_scope": "Scenario roles and covers/relates_to mappings govern coverage authority. Full-stream replay is an evidence-integrity and drift check; downstream contracts select accepted semantic fields."
  },
