+/// PROTOTYPE ONLY: evaluates Chebyshev polynomials and their first two derivatives.
+fn evaluate_chebyshev_polynomials_with_second(
+    num_columns: usize,
+    num_rows: usize,
+    nodes: &[f64],
+) -> (Mat<f64>, Mat<f64>, Mat<f64>) {
+    let mut tn_x = Mat::<f64>::ones(num_rows, num_columns);
+    let mut dtn_x = Mat::<f64>::zeros(num_rows, num_columns);
+    let mut ddtn_x = Mat::<f64>::zeros(num_rows, num_columns);
+
+    if num_columns > 1 {
+        for i in 0..num_rows {
+            tn_x[(i, 1)] = nodes[i];
+            dtn_x[(i, 1)] = 1.0;
+        }
+    }
+
+    for j in 2..num_columns {
+        for i in 0..num_rows {
+            let x = nodes[i];
+            tn_x[(i, j)] = 2.0 * x * tn_x[(i, j - 1)] - tn_x[(i, j - 2)];
+            dtn_x[(i, j)] =
+                2.0 * tn_x[(i, j - 1)] + 2.0 * x * dtn_x[(i, j - 1)] - dtn_x[(i, j - 2)];
+            ddtn_x[(i, j)] =
+                4.0 * dtn_x[(i, j - 1)] + 2.0 * x * ddtn_x[(i, j - 1)] - ddtn_x[(i, j - 2)];
+        }
+    }
+
+    (tn_x, dtn_x, ddtn_x)
+}
